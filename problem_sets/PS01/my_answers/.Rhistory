pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
lapply(c("stringr"),  pkgTest)
y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108, 87, 90, 94, 113, 112, 98, 80, 97, 95, 111, 114, 89, 95, 126, 98)
meanY <- mean(y)
stdevY <- sd(y)
students <- length(y)
seY <- stdevY/sqrt(students)
TStat <- qt(0.95, 24)
TStat * seY
meanY
lowerbound <- meanY - TStat * seY
upperbound <- meanY + TStat * seY
CI <- c(lowerbound, upperbound)
#Null Hypothesis Student IQ =< 100
#Alternative Hypothesis Student IQ > 100
tteststat <- (meanY - 100) / seY
tteststat
df <- length(y) - 1
pvalue <- 2*pt(abs(tteststat), df = df, lower.tail=FALSE)
t.test(y, mu = 100, alternative = "greater")
t.test(y, mu = 100, alternative = "less")
pvalue <- 2*pt(abs(tteststat), df = df, lower.tail=TRUE)
pvalue
pvalue <- pt(abs(tteststat), df = df, lower.tail=TRUE)
pvalue
CI <- c(lowerbound, upperbound)
CI
print("Confidence Interval is", CI, "Mean is:", meanY, "Standard Error is:", seY, "Standard Deviation is:", sdY)
print("Confidence Interval is", CI, "Mean is:", meanY, "Standard Error is:", seY, "Standard Deviation is:", stdevY)
cat("Confidence Interval is", CI, "Mean is:", meanY, "Standard Error is:", seY, "Standard Deviation is:", stdevY)
