try2 <- function(expr, silent = FALSE) {
tryCatch(
error = function(cnd) {
msg <- conditionMessage(cnd)
if (!silent) {
message("Error: ", msg)
}
structure(msg, class = "try-error")
},
expr
)
}
try2(1)
#> [1] 1
try2(stop("Hi"))
survey_spain   <- data.frame(id = 1:5,
age = c(23, 35, 41, 29, 52),
income = c(30000, 45000, NA, 38000, 61000),
trust = c(4, 5, 3, 2, 5))
survey_ireland <- data.frame(id = 1:4,
age = c(19, 230, 33, 45),      # 230 is a typo
income = c(22000, 50000, 41000, 39000),
trust = c(1, 3, 9, 4))         # 9 is off the scale
survey_poland  <- data.frame(id = 1:3,
age = c(30, 40, 50),
salary = c(28000, 31000, 35000),  # wrong column name!
trust = c(3, 4, 2))
surveys <- list(spain = survey_spain,
ireland = survey_ireland,
poland = survey_poland)
# Custom error: a required column is missing
check_columns <- function(df, country,
required = c("id", "age", "income", "trust")) {
missing <- setdiff(required, names(df))
if (length(missing) > 0) {
abort(
"error_missing_column",                        # the label
message = paste0(country, ": missing column(s): ",
paste(missing, collapse = ", ")),
country = country,                             # extra info
columns = missing
)
}
}
clean_survey <- function(df, country) {
check_columns(df, country)                         # error if columns are wrong
message("Cleaning ", country, " (", nrow(df), " respondents)")   # FYI
bad_age <- df$age > 110
if (any(bad_age)) {
warn(paste0(country, ": ", sum(bad_age), " impossible age(s) set to NA"))
df$age[bad_age] <- NA                            # recovered, so a warning
}
bad_trust <- df$trust > 5
if (any(bad_trust)) {
warn(paste0(country, ": ", sum(bad_trust), " trust score(s) off the 1-5 scale set to NA"))
df$trust[bad_trust] <- NA
}
df$country <- country
df
}
process_country <- function(df, country) {
warnings_log <- character()
result <- tryCatch(
# exiting handler for the custom error: skip this country
error_missing_column = function(cnd) {
message("SKIPPING ", cnd$country, ": needs ", paste(cnd$columns, collapse = ", "))
NULL
},
# calling handler for warnings: record them, then keep going
withCallingHandlers(
warning = function(cnd) {
warnings_log <<- c(warnings_log, conditionMessage(cnd))
cnd_muffle(cnd)
},
clean_survey(df, country)
)
)
out <- lapply(names(surveys), function(cn) process_country(surveys[[cn]], cn))
names(out) <- names(surveys)
out
out
out <- lapply(names(surveys), function(cn) process_country(surveys[[cn]], cn))
names(out) <- names(surveys)
good <- Filter(Negate(is.null), lapply(out, `[[`, "data"))
combined <- do.call(rbind, good)
combined
lapply(out, `[[`, "warnings")
