expenditure <- read.table("https://raw.githubusercontent.com/ASDS-TCD/StatsI_2026/main/datasets/expenditure.txt", header=T)
library(ggplot2)
#Question 1
pdf("Scatterplot of the Variables")
pairs(~ Y + X1 + X2 + X3, data = expenditure, col = "blue") +
title("Scatterplot of the Variables", sub = NULL, xlab = NULL, line = 3)
pairs(~ Y + X1 + X2 + X3, data = expenditure, col = "blue") +
title("Scatterplot of the Variables", sub = NULL, xlab = NULL, line = 3)
pairs(~ Y + X1 + X2 + X3, data = expenditure, col = "blue") +
title("Scatterplot of the Variables", sub = NULL, xlab = NULL, line = 3)
ggplot(expenditure, aes(x=factor(Region), y=Y)) +
geom_boxplot(fill = "red") +
labs(x = "Region", y = "expenditure per capita")
pairs(~ Y + X1 + X2 + X3, data = expenditure, col = "blue",
upper.panel = NULL) +
title("Scatterplot of the Variables", sub = NULL, xlab = NULL, line = 3)
#Question 1
expenditure <- read.table("https://raw.githubusercontent.com/ASDS-TCD/StatsI_2026/main/datasets/expenditure.txt", header=T)
library(ggplot2)
#Question 1
pdf("Scatterplot of the Variables.pdf")
pairs(~ Y + X1 + X2 + X3, data = expenditure, col = "blue",
upper.panel = NULL) +
title("Scatterplot of the Variables", sub = NULL, xlab = NULL, line = 3)
dev.off()
#Question 2
#Question 2
#Renaming
expenditure$Region <- expenditure$Region |>
mutate(
Region = 1 ~ "Northeast",
Region == 2 ~ "Northcenteral",
Region == 3 ~ "South",
Region == 4 ~ "West"
)
ggplot(expenditure, aes(x=factor(Region), y=Y, colour = factor(Region)) +
geom_boxplot() +
scale_color_manual(values = c("red", "violet", "blue", "orange")) +
labs(title = "Expenditure on Housing and Shelter by Region", x = "Region", y = "Expenditure per Capita", colour = "Region")
dev.off()
